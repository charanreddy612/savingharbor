---
interface Props {
  totalSavings: number;
  activeCoupons: number;
}
const { totalSavings, activeCoupons } = Astro.props;
---

<div class="card-base p-4">
  <h3 class="text-lg font-semibold mb-3 flex items-center gap-2">
    ⚡ Savings Impact
  </h3>

  <div
    class="rounded-lg p-4 text-white text-center"
    style="background: linear-gradient(135deg,#5b7cff,#8b5cf6);"
  >
    <div class="text-sm opacity-90">Total Savings Generated</div>
    <div class="text-2xl font-bold mt-1">
      ${totalSavings.toLocaleString()}+
    </div>
  </div>

  <div class="mt-4 text-sm text-gray-700 space-y-2">
    <div class="flex justify-between">
      <span>Active Coupons</span>
      <span class="font-medium">{activeCoupons}</span>
    </div>
    <div class="flex justify-between">
      <span>Updated</span>
      <span class="font-medium">Today</span>
    </div>
  </div>
</div>
