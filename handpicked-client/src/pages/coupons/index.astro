---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { api } from "../../lib/api";
import CouponRevealIsland from "../../components/islands/CouponRevealIsland.astro";

type merchant = {
  id: number | null;
  slug: string | null;
  logo_url: String | null;
};

type Coupon = {
  id: string | number;
  title?: string | null;
  code?: string | null;
  ends_at?: string | null;
  merchant_name?: string | null;
  merchant_id?: number | null;
  merchant: merchant | null;
};

type CouponsResponse = {
  data: Coupon[];
  meta: {
    page?: number;
    limit?: number;
    total?: number;
    canonical?: string;
    prev?: string | null;
    next?: string | null;
    next_cursor?: string | null;
    total_pages?: number;
    jsonld?: any;
    title?: string;
    description?: string;
  };
};

// let resp: CouponsResponse | null = null;
// try {
//   const url = new URL(Astro.request.url);
//   const params = new URLSearchParams(url.search);

//   // Force cursor mode for infinite scroll (empty cursor = first page)
//   if (!params.has("page") && !params.has("cursor")) {
//     params.set("cursor", "");
//   }

//   resp = await api.get<CouponsResponse>(
//     `/coupons?${params}`,
//     {},
//     { retries: 2, timeout: 8000 },
//   );
// }

let resp: CouponsResponse | null = null;
try {
  // Build clean params for cursor mode
  const cleanParams = new URLSearchParams({
    cursor: "",
    limit: "50",
    type: "all",
    status: "active",
    sort: "latest",
    locale: "en",
  });

  resp = await api.get<CouponsResponse>(
    `/coupons?${cleanParams}`,
    {},
    { retries: 2, timeout: 8000 },
  );
} catch (e) {
  console.error("Error fetching coupons:", e);
  resp = {
    data: [],
    meta: {
      page: 1,
      limit: 0,
      total: 0,
      prev: null,
      next: null,
      total_pages: 1,
      title: "Coupons - Saving Harbor",
      description: "Coupons temporarily unavailable.",
      canonical: undefined,
      jsonld: undefined,
    },
  };
}

const coupons = resp?.data || [];
const meta = resp?.meta || {};
const pageTitle = meta.title || "Coupons - Saving Harbor";
const pageDesc =
  meta.description || "Browse verified, handpicked coupons and deals.";
const canonical = `https://savingharbor.com${Astro.url.pathname}`;
const jsonld = meta.jsonld;
const nextUrl = meta.next || null;
---

<Base meta={{ title: pageTitle, description: pageDesc, canonical, jsonld }}>
  <Header />
  <main class="container mx-auto px-4 py-10">
    <h1 class="text-2xl font-bold text-brand-primary">Coupons</h1>
    <p class="mt-2 text-sm text-gray-500 max-w-2xl">{pageDesc}</p>

    {
      coupons.length > 0 ? (
        <div
          id="resource-list"
          data-resource="coupons"
          data-next-url={nextUrl}
          class="mt-6"
        >
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
            {coupons.map((c) => (
              <div
                class="rounded-md bg-white/5 p-3 transition-shadow hover:shadow-store-card"
                style="border-top-width: 3px; border-top-style: solid; border-top-color: transparent;"
              >
                <CouponRevealIsland
                  client:visible
                  coupon={c}
                  storeSlug={c.merchant?.slug}
                />
              </div>
            ))}
          </div>
        </div>
      ) : (
        <p class="mt-6 text-gray-500">
          No coupons available right now. Check back soon.
        </p>
      )
    }
  </main>
  <Footer />

  <script>
    import { createElement } from "react";
    import { createRoot } from "react-dom/client";
    import CouponReveal from "../../components/couponReveal.jsx";

    let loading = false;
    let hasMore = true;
    let nextUrl: string | null = null;

    const observer = new IntersectionObserver(
      (entries) => {
        console.log(
          "Sentinel intersecting:",
          entries[0].isIntersecting,
          "loading:",
          loading,
          "hasMore:",
          hasMore,
          "nextUrl:",
          nextUrl,
        );
        if (entries[0].isIntersecting && !loading && hasMore && nextUrl) {
          loadMore();
        }
      },
      { rootMargin: "200px" },
    );

    async function loadMore() {
      if (!nextUrl) return;
      console.log("Loading more from:", nextUrl);
      loading = true;
      try {
        const res = await fetch(nextUrl);
        const json = await res.json();
        console.log("Received:", json);

        if (json.data?.length) {
          appendCoupons(json.data);
          nextUrl = json.meta.next || null;
          hasMore = !!nextUrl;
          console.log("Next URL:", nextUrl);
        } else {
          hasMore = false;
        }
      } catch (e) {
        console.error("Load more failed:", e);
      } finally {
        loading = false;
      }
    }

    function appendCoupons(coupons: any[]) {
      const grid = document.querySelector("#resource-list .grid");
      if (!grid) return;

      coupons.forEach((c) => {
        const div = document.createElement("div");
        div.className =
          "rounded-md bg-white/5 p-3 transition-shadow hover:shadow-store-card";
        div.style.cssText =
          "border-top-width:3px;border-top-style:solid;border-top-color:transparent";

        grid.appendChild(div);
        createRoot(div).render(
          createElement(CouponReveal, {
            coupon: c,
            storeSlug: c.merchant?.slug,
          }),
        );
      });
    }

    const resourceList = document.querySelector(
      "#resource-list",
    ) as HTMLElement;
    console.log("Resource list found:", !!resourceList);

    if (resourceList?.dataset?.resource === "coupons") {
      const nextUrlEl = document.querySelector(
        "[data-next-url]",
      ) as HTMLElement;
      nextUrl = nextUrlEl?.dataset?.nextUrl || null;
      hasMore = !!nextUrl;

      console.log("Initial nextUrl:", nextUrl, "hasMore:", hasMore);

      const sentinel = document.createElement("div");
      sentinel.id = "scroll-sentinel";
      sentinel.style.height = "20px"; // Increase height
      sentinel.style.backgroundColor = "red"; // Visual debug
      resourceList.appendChild(sentinel);

      // Add immediate intersection check
      setTimeout(() => {
        const rect = sentinel.getBoundingClientRect();
        console.log(
          "Sentinel position:",
          rect,
          "In viewport:",
          rect.top < window.innerHeight,
        );
      }, 100);

      observer.observe(sentinel);
      console.log("Observer attached to sentinel");
    }
  </script>
</Base>
